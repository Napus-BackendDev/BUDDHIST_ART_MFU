# Copy to .env.production and set the public OAuth client ID used by the backend.
VUE_APP_TITLE=Buddhist Art MFU
VUE_APP_API_URL=https://bas.beta.mfu.ac.th
VUE_APP_VERSION=1.0.0
VUE_APP_CLIENTID=REPLACE_WITH_GOOGLE_CLIENT_ID.apps.googleusercontent.com
VUE_APP_SCOPE=profile email
VUE_APP_PROMPT=select_account
