  "description": "```bash pnpm start ``` ###Install Package ```bash pnpm install [package name] ```",
  "main": "server.js",
  "scripts": {
    "test": "jest --runInBand --forceExit",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "start": "nodemon -r dotenv/config server.js dotenv_config_path=.env.development",
    "serve:dev": "node -r dotenv/config server.js dotenv_config_path=.env.development",
    "serve:test": "node -r dotenv/config server.js dotenv_config_path=.env.test",
    "serve:prod": "node -r dotenv/config server.js dotenv_config_path=.env.production",
    "seed:settings": "node scripts/seedSettings.js",
    "seed:all": "node scripts/seedSettings.js",
    "migrate:setting-codes": "node scripts/migrateSettingCodes.js",
    "ensure:setting-defaults": "node scripts/ensureSettingDefaults.js",
    "migrate:artist-emails": "node -r dotenv/config scripts/migrateArtistOfficialEmails.js dotenv_config_path=.env.development",
    "migrate:local-to-production": "node scripts/migrateLocalToProduction.js",
    "seed:mock-orders": "node scripts/seedMockOrders.js",
    "migrate:post-term": "node scripts/migratePostTermSale.js"
  },
