NODE_ENV=development
PORT=8081
MONGODB=mongodb://localhost:27017/Buddhist
JWT_SECRET=replace-with-environment-specific-secret
TOKENEXPIRED=1
TIMEOUT=30000
TRANSACTIONEXPIRED=30
ALLOW_DEV_ADMIN_LOGIN=false
ALLOW_UNVERIFIED_GOOGLE_DEV=false
# false enables API protection in development too; true explicitly bypasses it.
DISABLE_IP_BLOCKING=false
# Leave empty until the actual reverse proxy addresses are verified.
# Same-host Nginx example ONLY: TRUSTED_PROXIES=127.0.0.1,::1
# Restrict direct backend access; trusted proxies must sanitize forwarded headers.
TRUSTED_PROXIES=
# Optional exact client IP allowlist for private deployments. Public gallery leaves empty.
API_ALLOWED_IPS=
# Initial per-IP budgets; tune from traffic. Authentication counts failures.
# Read/image/write windows: 1 minute; upload: 5 minutes; auth: 15 minutes.
RATE_LIMIT_READ_MAX=120
RATE_LIMIT_IMAGE_MAX=60
RATE_LIMIT_WRITE_MAX=30
RATE_LIMIT_UPLOAD_MAX=10
RATE_LIMIT_AUTH_MAX=10
EMAIL_ENABLED=true

# Shared artwork/image storage (MFU Nextcloud public WebDAV share)
MFU_DRIVE_ENABLED=false
MFU_DRIVE_SHARE_URL=https://mfudrive.mfu.ac.th/s/replace-with-share-token
MFU_DRIVE_WEBDAV_URL=https://mfudrive.mfu.ac.th/public.php/dav/files/replace-with-share-token
MFU_DRIVE_PUBLIC_URL=https://mfudrive.mfu.ac.th/public.php/dav/files/replace-with-share-token
MFU_DRIVE_USERNAME=
MFU_DRIVE_PASSWORD=
MFU_DRIVE_TIMEOUT_MS=30000

# Optional integrations
BASE_SERVER_URL=http://localhost:8081
CLIENT_URL=http://localhost:8080
GOOGLE_CLIENT_ID=
GOOGLE_SECRET=
REDIRECT_URL=
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
