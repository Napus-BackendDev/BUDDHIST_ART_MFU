{
  "openapi": "3.0.0",
  "info": {
    "title": "Buddhist Art API",
    "description": "API documentation for Buddhist Art Management System",
    "version": "1.0.0",
    "contact": {
      "name": "API Support"
    }
  },
  "servers": [
    {
      "url": "http://localhost:8081/api/v1",
      "description": "Development server"
    }
  ],
  "tags": [
    { "name": "User", "description": "Operations about users" },
    { "name": "Order", "description": "Operations about orders" },
    { "name": "Artwork", "description": "Operations about artworks" },
    { "name": "New", "description": "Operations about news/events" },
    { "name": "Settings Status", "description": "Status configuration" },
    { "name": "Settings Message", "description": "Message configuration" },
    { "name": "Settings Group", "description": "Group configuration" },
    { "name": "Settings Verification", "description": "Verification configuration" }
  ],
  "paths": {
    "/user": {
      "get": {
        "tags": ["User"],
        "summary": "Get all users",
        "responses": { "200": { "description": "OK" } }
      },
      "post": {
        "tags": ["User"],
        "summary": "Create new user",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/User" }
            }
          }
        },
        "responses": { "200": { "description": "OK" } }
      },
      "put": {
        "tags": ["User"],
        "summary": "Update user",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "_id": { "type": "string" }
                },
                "allOf": [{ "$ref": "#/components/schemas/User" }]
              }
            }
          }
        },
        "responses": { "200": { "description": "OK" } }
      },
      "delete": {
        "tags": ["User"],
        "summary": "Delete user",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": { "_id": { "type": "string" } }
              }
            }
          }
        },
        "responses": { "200": { "description": "OK" } }
      }
    },
    "/user/explore": {
      "post": {
        "tags": ["User"],
        "summary": "Explore user by ID",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": { "_id": { "type": "string" } }
              }
            }
          }
        },
        "responses": { "200": { "description": "OK" } }
      }
    },
    "/order": {
      "get": {
        "tags": ["Order"],
        "summary": "Get all orders",
        "responses": { "200": { "description": "OK" } }
      },
      "post": {
        "tags": ["Order"],
        "summary": "Create new order",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/Order" }
            }
          }
        },
        "responses": { "200": { "description": "OK" } }
      },
      "put": {
        "tags": ["Order"],
        "summary": "Update order",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": { "_id": { "type": "string" } },
                "allOf": [{ "$ref": "#/components/schemas/Order" }]
              }
            }
          }
        },
        "responses": { "200": { "description": "OK" } }
      },
      "delete": {
        "tags": ["Order"],
        "summary": "Delete order",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": { "_id": { "type": "string" } }
              }
            }
          }
        },
        "responses": { "200": { "description": "OK" } }
      }
    },
    "/new": {
      "get": {
        "tags": ["New"],
        "summary": "Get all news",
        "responses": { "200": { "description": "OK" } }
      },
      "post": {
        "tags": ["New"],
        "summary": "Create new news",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/New" }
            }
          }
        },
        "responses": { "200": { "description": "OK" } }
      },
      "put": {
        "tags": ["New"],
        "summary": "Update news",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": { "_id": { "type": "string" } },
                "allOf": [{ "$ref": "#/components/schemas/New" }]
              }
            }
          }
        },
        "responses": { "200": { "description": "OK" } }
      },
      "delete": {
        "tags": ["New"],
        "summary": "Delete news",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": { "_id": { "type": "string" } }
              }
            }
          }
        },
        "responses": { "200": { "description": "OK" } }
      }
    },
    "/new/upload": {
      "put": {
        "tags": ["New"],
        "summary": "Upload news image",
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "_id": { "type": "string" },
                  "image": { "type": "string", "format": "binary" }
                }
              }
            }
          }
        },
        "responses": { "200": { "description": "OK" } }
      }
    },
    "/new/explore": {
      "post": {
        "tags": ["New"],
        "summary": "Explore news by ID",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": { "_id": { "type": "string" } }
              }
            }
          }
        },
        "responses": { "200": { "description": "OK" } }
      }
    },
    "/artwork": {
      "get": {
        "tags": ["Artwork"],
        "summary": "Get all artworks",
        "responses": { "200": { "description": "OK" } }
      },
      "post": {
        "tags": ["Artwork"],
        "summary": "Create new artwork",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/Artwork" }
            }
          }
        },
        "responses": { "200": { "description": "OK" } }
      },
      "put": {
        "tags": ["Artwork"],
        "summary": "Update artwork",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": { "_id": { "type": "string" } },
                "allOf": [{ "$ref": "#/components/schemas/Artwork" }]
              }
            }
          }
        },
        "responses": { "200": { "description": "OK" } }
      },
      "delete": {
        "tags": ["Artwork"],
        "summary": "Delete artwork",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": { "_id": { "type": "string" } }
              }
            }
          }
        },
        "responses": { "200": { "description": "OK" } }
      }
    },
    "/artwork/upload": {
      "put": {
        "tags": ["Artwork"],
        "summary": "Upload artwork image",
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "_id": { "type": "string" },
                  "image": { "type": "string", "format": "binary" }
                }
              }
            }
          }
        },
        "responses": { "200": { "description": "OK" } }
      }
    },
    "/artwork/explore": {
      "post": {
        "tags": ["Artwork"],
        "summary": "Explore artwork by ID",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": { "_id": { "type": "string" } }
              }
            }
          }
        },
        "responses": { "200": { "description": "OK" } }
      }
    },
    "/artwork/category": {
      "get": {
        "tags": ["Artwork"],
        "summary": "Get categories",
        "responses": { "200": { "description": "OK" } }
      },
      "post": {
        "tags": ["Artwork"],
        "summary": "Create category",
        "responses": { "200": { "description": "OK" } }
      }
    },
    "/settings/status": {
      "get": {
        "tags": ["Settings Status"],
        "summary": "Get all statuses",
        "responses": { "200": { "description": "OK" } }
      },
      "post": {
        "tags": ["Settings Status"],
        "summary": "Create status",
        "responses": { "200": { "description": "OK" } }
      }
    }
  },
  "components": {
    "schemas": {
      "User": {
        "type": "object",
        "properties": {
          "studentId": { "type": "string" },
          "image": { "type": "string" },
          "name": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/KeyValue" }
          },
          "contact": {
            "type": "object",
            "properties": {
              "telephone": { "type": "string" },
              "studentEmail": { "type": "string" },
              "personalEmail": { "type": "string" }
            }
          },
          "password": { "type": "string" },
          "status": { "type": "string" }
        }
      },
      "Order": {
        "type": "object",
        "properties": {
          "image": { "type": "string" },
          "contact": {
            "type": "object",
            "properties": {
              "name": { "type": "string" },
              "telephone": { "type": "string" },
              "email": { "type": "string" }
            }
          },
          "address": {
            "type": "object",
            "properties": {
              "bill": { "type": "string" },
              "shipping": { "type": "string" }
            }
          },
          "artwork": {
            "type": "array",
            "items": { "type": "string" }
          },
          "approvalStatus": { "type": "string" }
        }
      },
      "New": {
        "type": "object",
        "properties": {
          "image": { "type": "string" },
          "title": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/KeyValue" }
          },
          "description": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/KeyValue" }
          },
          "location": { "type": "string" }
        }
      },
      "Artwork": {
        "type": "object",
        "properties": {
          "code": { "type": "string" },
          "title": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/KeyValue" }
          },
          "owner": { "type": "string" },
          "size": { "type": "string" },
          "technique": { "type": "string" },
          "price": { "type": "number" },
          "concept": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/KeyValue" }
          },
          "category": { "type": "string" },
          "presentation": { "type": "string" },
          "approvalStatus": { "type": "string" },
          "saleStatus": { "type": "string" }
        }
      },
      "KeyValue": {
        "type": "object",
        "properties": {
          "key": { "type": "string" },
          "value": { "type": "string" }
        }
      }
    }
  }
}
