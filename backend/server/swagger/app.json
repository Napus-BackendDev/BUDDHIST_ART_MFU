    "/artwork": {
      "get": {
        "tags": ["Artwork"],
        "summary": "Get all artworks",
        "description": "Retrieve all artwork records"
      },
      "post": {
        "tags": ["Artwork"],
        "summary": "Create new artwork",
        "description": "Create a new artwork record",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "code": {
                    "type": "string",
                    "example": "P003"
                  },
                  "title": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "key": { "type": "string" },
                        "value": { "type": "string" }
                      }
                    }
                  },
                  "owner": {
                    "type": "string",
                    "example": "507f1f77bcf86cd799439011"
                  },
                  "size": {
                    "type": "string"
                  },
                  "technique": {
                    "type": "string",
                    "example": "689c04cb255db4e56aea88ef"
                  },
                  "price": {
                    "type": "number",
                    "example": 1500
                  },
                  "concept": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "key": { "type": "string" },
                        "value": { "type": "string" }
                      }
                    }
                  },
                  "category": {
                    "type": "string",
                    "example": "689c04cb255db4e56aea88ef"
                  },
                  "presentation": {
                    "type": "string",
                    "example": "689c04cb255db4e56aea88ef"
                  },
                  "approvalStatus": {
                    "type": "string",
                    "example": "689c04cb255db4e56aea88ef"
                  },
                  "saleStatus": {
                    "type": "string",
                    "example": "689c04cb255db4e56aea88ef"
                  }
                },
                "required": ["title", "code"]
              }
            }
          }
        }
      },
      "put": {
        "tags": ["Artwork"],
        "summary": "Update artwork",
        "description": "Update an existing artwork record",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "_id": {
                    "type": "string",
                    "example": "507f1f77bcf86cd799439011"
                  },
                  "code": {
                    "type": "string",
                    "example": "P003"
                  },
                  "title": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "key": { "type": "string" },
                        "value": { "type": "string" }
                      }
                    }
                  },
                  "owner": {
                    "type": "string",
                    "example": "507f1f77bcf86cd799439011"
                  },
                  "size": {
                    "type": "string"
                  },
                  "technique": {
                    "type": "string",
                    "example": "689c04cb255db4e56aea88ef"
                  },
                  "price": {
                    "type": "number",
                    "example": 1500
                  },
                  "concept": {
                    "type": "object",
                    "properties": {
                      "en": {
                        "type": "string",
                        "example": "Concept in English"
                      },
                      "th": {
                        "type": "string",
                        "example": "แนวคิดภาษาไทย"
                      }
                    }
                  },
                  "category": {
                    "type": "string",
                    "example": "689c04cb255db4e56aea88ef"
                  },
                  "presentation": {
                    "type": "string",
                    "example": "689c04cb255db4e56aea88ef"
                  },
                  "approvalStatus": {
                    "type": "string",
                    "example": "689c04cb255db4e56aea88ef"
                  },
                  "saleStatus": {
                    "type": "string",
                    "example": "689c04cb255db4e56aea88ef"
                  }
