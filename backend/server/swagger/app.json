{
  "openapi": "3.0.0",
  "info": {
    "title": "Buddhist Art API",
    "description": "API documentation for Buddhist Art Management System",
    "version": "1.0.0",
    "contact": {
      "name": "API Support"
    }
  },
  "servers": [
    {
      "url": "http://localhost:8081/api/v1",
      "description": "Development server"
    }
  ],
  "tags": [
    { "name": "User", "description": "Operations about users" },
    { "name": "Artwork", "description": "Operations about artworks" },
    { "name": "Submission", "description": "Operations about artwork submissions" },
    { "name": "Order", "description": "Operations about orders" },
    { "name": "Settings", "description": "System configuration (Status, Group, Role, etc.)" }
  ],
  "paths": {
    "/user": {
      "get": {
        "tags": ["User"],
        "summary": "Get all users",
        "responses": { "200": { "description": "OK" } }
      },
      "post": {
        "tags": ["User"],
        "summary": "Create new user",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/User" }
            }
          }
        },
        "responses": { "200": { "description": "OK" } }
      },
      "put": {
        "tags": ["User"],
        "summary": "Update user",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "_id": { "type": "string" }
                },
                "allOf": [{ "$ref": "#/components/schemas/User" }]
              }
            }
          }
        },
        "responses": { "200": { "description": "OK" } }
      },
      "delete": {
        "tags": ["User"],
        "summary": "Delete user",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": { "_id": { "type": "string" } }
              }
            }
          }
        },
        "responses": { "200": { "description": "OK" } }
      }
    },
    "/user/explore": {
      "post": {
        "tags": ["User"],
        "summary": "Explore user by ID",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": { "_id": { "type": "string" } }
              }
            }
          }
        },
        "responses": { "200": { "description": "OK" } }
      }
    },
    "/artwork": {
      "get": {
        "tags": ["Artwork"],
        "summary": "Get all artworks",
        "responses": { "200": { "description": "OK" } }
      },
      "post": {
        "tags": ["Artwork"],
        "summary": "Create new artwork",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/Artwork" }
            }
          }
        },
        "responses": { "200": { "description": "OK" } }
      },
      "put": {
        "tags": ["Artwork"],
        "summary": "Update artwork",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": { "_id": { "type": "string" } },
                "allOf": [{ "$ref": "#/components/schemas/Artwork" }]
              }
            }
          }
        },
        "responses": { "200": { "description": "OK" } }
      },
      "delete": {
        "tags": ["Artwork"],
        "summary": "Delete artwork",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": { "_id": { "type": "string" } }
              }
            }
          }
        },
        "responses": { "200": { "description": "OK" } }
      }
    },
    "/artwork/explore": {
      "post": {
        "tags": ["Artwork"],
        "summary": "Explore artwork (Search/Filter)",
        "responses": { "200": { "description": "OK" } }
      }
    },
    "/artwork/upload": {
      "put": {
        "tags": ["Artwork"],
        "summary": "Upload artwork image",
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "_id": { "type": "string" },
                  "image": { "type": "string", "format": "binary" }
                }
              }
            }
          }
        },
        "responses": { "200": { "description": "OK" } }
      }
    },
    "/artwork/category": {
      "get": {
        "tags": ["Artwork"],
        "summary": "Get artwork categories",
        "responses": { "200": { "description": "OK" } }
      }
    },
    "/submission": {
      "get": {
        "tags": ["Submission"],
        "summary": "Get all submissions",
        "responses": { "200": { "description": "OK" } }
      },
      "post": {
        "tags": ["Submission"],
        "summary": "Create new submission",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/Submission" }
            }
          }
        },
        "responses": { "200": { "description": "OK" } }
      },
      "put": {
        "tags": ["Submission"],
        "summary": "Update submission",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": { "_id": { "type": "string" } },
                "allOf": [{ "$ref": "#/components/schemas/Submission" }]
              }
            }
          }
        },
        "responses": { "200": { "description": "OK" } }
      },
      "delete": {
        "tags": ["Submission"],
        "summary": "Delete submission",
        "responses": { "200": { "description": "OK" } }
      }
    },
    "/submission/explore": {
      "post": {
        "tags": ["Submission"],
        "summary": "Explore submission by ID",
        "responses": { "200": { "description": "OK" } }
      }
    },
    "/order": {
      "get": {
        "tags": ["Order"],
        "summary": "Get all orders",
        "responses": { "200": { "description": "OK" } }
      },
      "post": {
        "tags": ["Order"],
        "summary": "Create new order",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/Order" }
            }
          }
        },
        "responses": { "200": { "description": "OK" } }
      }
    },
    "/settings/group": {
      "get": {
        "tags": ["Settings"],
        "summary": "Get all setting groups",
        "responses": { "200": { "description": "OK" } }
      }
    },
    "/settings/status": {
      "get": {
        "tags": ["Settings"],
        "summary": "Get all setting statuses",
        "responses": { "200": { "description": "OK" } }
      }
    },
    "/settings/role": {
      "get": {
        "tags": ["Settings"],
        "summary": "Get all setting roles",
        "responses": { "200": { "description": "OK" } }
      }
    }
  },
  "components": {
    "schemas": {
      "KeyValue": {
        "type": "object",
        "properties": {
          "key": { "type": "string", "example": "en" },
          "value": { "type": "string", "example": "English Content" }
        }
      },
      "User": {
        "type": "object",
        "properties": {
          "studentId": { "type": "string" },
          "image": { "type": "string", "nullable": true },
          "name": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/KeyValue" }
          },
          "role": { "type": "string", "description": "Role ObjectId" },
          "bio": { "type": "string", "nullable": true },
          "contact": {
            "type": "object",
            "properties": {
              "telephone": { "type": "string", "nullable": true },
              "studentEmail": { "type": "string" },
              "personalEmail": { "type": "string", "nullable": true }
            }
          },
          "status": { "type": "string", "description": "Status ObjectId" }
        }
      },
      "Artwork": {
        "type": "object",
        "properties": {
          "image": { "type": "string", "nullable": true },
          "title": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/KeyValue" }
          },
          "description": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/KeyValue" }
          },
          "artist": { "type": "string", "description": "User ObjectId" },
          "technique": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/KeyValue" }
          },
          "price": { "type": "number", "default": 0 },
          "category": { "type": "string", "description": "Category ObjectId" },
          "status": {
            "type": "object",
            "properties": {
              "approval": { "type": "string", "description": "Status ObjectId" },
              "sale": { "type": "string", "description": "Status ObjectId" }
            }
          }
        }
      },
      "Submission": {
        "type": "object",
        "properties": {
          "title": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/KeyValue" }
          },
          "artist": { "type": "string", "description": "User ObjectId" },
          "assignments": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "category": { "type": "string", "description": "Category ObjectId" },
                "artworks": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "owner": { "type": "string", "description": "User ObjectId" },
                      "status": { "type": "string", "description": "Status ObjectId" }
                    }
                  }
                }
              }
            }
          }
        }
      },
      "Order": {
        "type": "object",
        "properties": {
          "image": { "type": "string", "default": "" },
          "contact": {
            "type": "object",
            "properties": {
              "name": { "type": "string", "nullable": true },
              "telephone": { "type": "string", "nullable": true },
              "email": { "type": "string", "nullable": true }
            }
          },
          "address": {
            "type": "object",
            "properties": {
              "bill": { "type": "string", "nullable": true },
              "shipping": { "type": "string", "nullable": true }
            }
          },
          "artwork": {
            "type": "array",
            "items": { "type": "string", "description": "Artwork ObjectId" }
          },
          "status": { "type": "string", "description": "Status ObjectId" }
        }
      },
      "Setting": {
        "type": "object",
        "properties": {
          "title": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/KeyValue" }
          },
          "description": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/KeyValue" }
          }
        }
      }
    }
  }
}
